# Datenbank
# Lokal z. B. postgresql://wegwaerts:<passwort>@127.0.0.1:5432/wegwaerts
# In Vercel: gepoolte Neon-Verbindung (Runtime).
DATABASE_URL=postgresql://wegwaerts:wegwaerts@127.0.0.1:5432/wegwaerts
# Direkte, ungepoolte Neon-Verbindung; nur für Migrationen verwenden.
DATABASE_MIGRATION_URL=
APP_ORIGIN=http://127.0.0.1:3000
PUBLIC_DEMO=false

# Anonyme Demo-Sitzungen und täglicher Vercel-Cron
# Mindestens 32 zufällige Bytes je Umgebung; niemals zwischen Preview und Produktion teilen.
SESSION_SECRET=
IP_HASH_SECRET=
CRON_SECRET=

# KI-Anbieter
# Produktion: workers-ai; lokale Entwicklung: ollama; Tests: mock.
AI_PROVIDER=ollama
AI_ENABLED=true
AI_MAX_OUTPUT_TOKENS=500
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=60000

# Cloudflare Turnstile
# Der Site-Key ist öffentlich. Der Secret-Key bleibt ausschließlich serverseitig.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Docker Compose (lokale Entwicklung)
POSTGRES_DB=wegwaerts
POSTGRES_USER=wegwaerts
POSTGRES_PASSWORD=wegwaerts
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=55432
APP_PORT=3000
OLLAMA_PORT=11434
OLLAMA_IMAGE=ollama/ollama:latest

# Tests
DATABASE_URL_TEST=
E2E_DATABASE_URL=

# Deaktiviert ausschließlich die Next.js-Telemetrie.
NEXT_TELEMETRY_DISABLED=1
